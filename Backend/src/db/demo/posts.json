  {
    "author": 1,
    "kind": "question",
    "caption": "Kyoto in autumn for 5 days: is the JR Pass worth it or should I just use IC cards?",
    "category": "culture",
    "place": {
      "name": "Kyoto",
      "country": "Japan",
      "countryCode": "JP"
    },
    "verified": false,
    "agoMin": 300,
    "stops": [],
    "answers": [
      {
        "author": 4,
        "text": "If you stay in Kyoto only, skip it. Buses and the subway with an ICOCA card are enough."
      },
      {
        "author": 2,
        "text": "Worth it only if you add a Tokyo round trip. The Shinkansen alone is most of the price."
      },
      {
        "author": 5,
        "text": "Rent a bike! Kyoto is flat and you'll beat the buses everywhere."
      }
    ]
  },
  {
