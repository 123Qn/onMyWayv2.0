# Same Postgres as the Backend (falls back to ../Backend/.env when not set here)
DATABASE_URL=postgres://user:password@localhost:5433/onmyway

# Local model served by Ollama (https://ollama.com): `ollama pull qwen2.5:3b`
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# The Backend calls this service at AI_BOT_URL (default http://127.0.0.1:3100)
AI_BOT_PORT=3100
